# Copy to .env for local development. Set the same variables in Vercel → Project → Settings → Environment Variables.

# --- Supabase (browser-safe; VITE_* values are bundled into the client) ---
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Supabase (server) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret / service-role key. SERVER ONLY — never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# HMAC secret for guest search-allowance tokens (any long random string). SERVER ONLY.
VISITOR_TOKEN_SECRET=

# --- Stripe (server only) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_QUARTERLY=price_...
STRIPE_PRICE_YEARLY=price_...

# Public site origin used for Stripe success/cancel redirects (optional; defaults to the request origin).
APP_URL=https://your-app.vercel.app

# Vercel build target for nitro (set in Vercel only).
# NITRO_PRESET=vercel
